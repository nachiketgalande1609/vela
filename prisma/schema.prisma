generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  name                String?
  password            String?   @db.Text // null for OAuth-only accounts
  role                Role      @default(USER)
  emailVerified       DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  sessions      Session[]
  oauthAccounts OAuthAccount[]
  tokens        VerificationToken[]
  purchases     Purchase[]
  subscription  Subscription?
  packPurchases PackPurchase[]
  cartItems             CartItem[]
  packCartItems         PackCartItem[]
  subscriptionCartItem  SubscriptionCartItem?
  wishlists             Wishlist[]

  @@index([email])
}

// Stores refresh tokens, one row per device/session
model Session {
  id           String   @id @default(cuid())
  userId       String
  refreshToken String   @unique @db.VarChar(512)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  userAgent    String?  @db.Text
  ipAddress    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Email verification and password-reset tokens
model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique @db.VarChar(512)
  type      TokenType
  expiresAt DateTime
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model OAuthAccount {
  id                String  @id @default(cuid())
  userId            String
  provider          String // "google" | "github"
  providerAccountId String
  accessToken       String? @db.Text
  refreshToken      String? @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Wallpaper {
  id          String   @id @default(cuid())
  title       String
  description String?
  price       Float
  category    String
  tags        String
  width       Int      @default(1080)
  height      Int      @default(1920)
  storagePath String
  previewPath String
  thumbPath   String
  published   Boolean  @default(false)
  isFree      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchases  Purchase[]
  packs      WallpaperOnPack[]
  cartItems  CartItem[]
  wishlists  Wishlist[]

  @@index([category])
  @@index([published])
}

model Purchase {
  id        String   @id @default(cuid())
  userId    String
  wallpaperId String
  paymentId String   @unique @map("stripePaymentId")
  amount    Float
  createdAt DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id])
  wallpaper Wallpaper @relation(fields: [wallpaperId], references: [id])

  @@unique([userId, wallpaperId])
  @@index([userId])
}

model Subscription {
  id             String   @id @default(cuid())
  userId         String   @unique
  subscriptionId String   @unique @map("stripeSubId")
  customerId     String   @map("stripeCustomerId")
  status         String   // active | canceled | past_due | trialing
  currentPeriodEnd DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Pack {
  id          String   @id @default(cuid())
  title       String
  description String?
  price       Float    @default(250)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  wallpapers    WallpaperOnPack[]
  purchases     PackPurchase[]
  packCartItems PackCartItem[]

  @@index([published])
}

model WallpaperOnPack {
  packId      String
  wallpaperId String
  order       Int    @default(0)

  pack      Pack      @relation(fields: [packId], references: [id], onDelete: Cascade)
  wallpaper Wallpaper @relation(fields: [wallpaperId], references: [id], onDelete: Cascade)

  @@id([packId, wallpaperId])
  @@index([packId])
}

model PackPurchase {
  id        String   @id @default(cuid())
  userId    String
  packId    String
  paymentId String   @unique
  amount    Float
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  pack Pack @relation(fields: [packId], references: [id])

  @@unique([userId, packId])
  @@index([userId])
}

model CartItem {
  id          String   @id @default(cuid())
  userId      String
  wallpaperId String
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallpaper Wallpaper @relation(fields: [wallpaperId], references: [id], onDelete: Cascade)

  @@unique([userId, wallpaperId])
  @@index([userId])
}

model DownloadNonce {
  id          String   @id @default(cuid())
  nonce       String   @unique
  userId      String
  wallpaperId String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([nonce])
  @@index([expiresAt])
}

model Wishlist {
  id          String   @id @default(cuid())
  userId      String
  wallpaperId String
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallpaper Wallpaper @relation(fields: [wallpaperId], references: [id], onDelete: Cascade)

  @@unique([userId, wallpaperId])
  @@index([userId])
}

model SubscriptionCartItem {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PackCartItem {
  id        String   @id @default(cuid())
  userId    String
  packId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  pack Pack @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@unique([userId, packId])
  @@index([userId])
}
